///|
/// Parse one complete FIX message from its ASCII TagValue wire representation.
pub fn parse_message(
  wire : String,
  limits? : ParseLimits = default_parse_limits(),
) -> Result[Message, CodecError] {
  if wire.length() > limits.max_message_bytes {
    return Err(
      codec_error(FramingLimit, 0, "message exceeds configured byte limit"),
    )
  }
  let mut i = 0
  while i < wire.length() {
    if wire.code_unit_at(i).to_int() > 127 {
      return Err(codec_error(NonAscii, i, "FIX TagValue wire must be ASCII"))
    }
    i += 1
  }
  let first = match read_field(wire, 0, wire.length()) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  if first.0.tag != 8 {
    return Err(
      codec_error(InvalidField, 0, "first field must be BeginString (8)"),
    )
  }
  let second = match read_field(wire, first.1, wire.length()) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  if second.0.tag != 9 {
    return Err(
      codec_error(InvalidField, first.1, "second field must be BodyLength (9)"),
    )
  }
  let body_length = match parse_decimal(second.0.value, second.1) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let body_start = second.1
  let checksum_start = body_start + body_length
  if checksum_start >= wire.length() {
    return Err(
      codec_error(
        BodyLengthMismatch,
        body_start,
        "BodyLength extends beyond input",
      ),
    )
  }
  if checksum_start + 7 != wire.length() {
    return Err(
      codec_error(
        BodyLengthMismatch,
        checksum_start,
        "BodyLength does not locate terminal CheckSum",
      ),
    )
  }
  if wire[checksum_start:checksum_start + 3] != "10=" ||
    wire[wire.length() - 1] != '\u{1}' {
    return Err(
      codec_error(
        InvalidChecksum,
        checksum_start,
        "terminal field must be 10=ddd<SOH>",
      ),
    )
  }
  let supplied = match
    parse_three_digits(
      wire[checksum_start + 3:checksum_start + 6].to_owned(),
      checksum_start + 3,
    ) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let mut sum = 0
  i = 0
  while i < checksum_start {
    sum = (sum + wire.code_unit_at(i).to_int()) % 256
    i += 1
  }
  if supplied != sum {
    return Err(
      codec_error(
        ChecksumMismatch,
        checksum_start + 3,
        "CheckSum does not match message prefix",
      ),
    )
  }
  let fields : Array[Field] = []
  i = body_start
  while i < checksum_start {
    if fields.length() >= limits.max_fields {
      return Err(
        codec_error(FramingLimit, i, "message exceeds configured field limit"),
      )
    }
    let parsed = match read_field(wire, i, checksum_start) {
      Ok(value) => value
      Err(error) => return Err(error)
    }
    if parsed.0.tag == 8 || parsed.0.tag == 9 || parsed.0.tag == 10 {
      return Err(
        codec_error(
          ReservedTag,
          i,
          "framing tags are not allowed inside message body",
        ),
      )
    }
    fields.push(parsed.0)
    i = parsed.1
  }
  Ok({ begin_string: first.0.value, fields, })
}

///|
/// Encode a message with computed BodyLength and CheckSum fields.
pub fn encode_message(message : Message) -> Result[String, CodecError] {
  if message.begin_string.length() == 0 || contains_soh(message.begin_string) {
    return Err(codec_error(InvalidField, 0, "BeginString cannot be empty"))
  }
  let mut body = ""
  for field in message.fields {
    if field.tag <= 0 {
      return Err(
        codec_error(InvalidTag, 0, "field tags must be positive integers"),
      )
    }
    if field.tag == 8 || field.tag == 9 || field.tag == 10 {
      return Err(
        codec_error(ReservedTag, 0, "framing tags are generated by the encoder"),
      )
    }
    if contains_soh(field.value) || contains_non_ascii(field.value) {
      return Err(
        codec_error(
          InvalidField,
          0,
          "field values must be ASCII and cannot contain SOH",
        ),
      )
    }
    body = body + field.tag.to_string() + "=" + field.value + "\u{1}"
  }
  let prefix = "8=" +
    message.begin_string +
    "\u{1}9=" +
    body.length().to_string() +
    "\u{1}" +
    body
  if contains_non_ascii(prefix) {
    return Err(codec_error(NonAscii, 0, "FIX wire values must be ASCII"))
  }
  let mut sum = 0
  let mut i = 0
  while i < prefix.length() {
    sum = (sum + prefix.code_unit_at(i).to_int()) % 256
    i += 1
  }
  let checksum = if sum < 10 {
    "00" + sum.to_string()
  } else if sum < 100 {
    "0" + sum.to_string()
  } else {
    sum.to_string()
  }
  Ok(prefix + "10=" + checksum + "\u{1}")
}

///|
fn read_field(
  wire : String,
  start : Int,
  limit : Int,
) -> Result[(Field, Int), CodecError] {
  if start >= limit {
    return Err(
      codec_error(
        InvalidField,
        start,
        "expected a field before message boundary",
      ),
    )
  }
  let mut equals = start
  while equals < limit && wire.code_unit_at(equals).to_int() != 61 {
    equals += 1
  }
  if equals == limit {
    return Err(
      codec_error(InvalidField, start, "field has no equals delimiter"),
    )
  }
  if equals == start {
    return Err(codec_error(InvalidTag, start, "field tag cannot be empty"))
  }
  let tag = match parse_decimal(wire[start:equals].to_owned(), start) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  if tag == 0 {
    return Err(codec_error(InvalidTag, start, "field tags must be positive"))
  }
  let mut end = equals + 1
  while end < limit && wire[end] != '\u{1}' {
    end += 1
  }
  if end == limit {
    return Err(
      codec_error(InvalidField, start, "field is missing its SOH terminator"),
    )
  }
  Ok(({ tag, value: wire[equals + 1:end].to_owned(), }, end + 1))
}

///|
fn parse_decimal(value : String, offset : Int) -> Result[Int, CodecError] {
  if value.length() == 0 {
    return Err(
      codec_error(InvalidBodyLength, offset, "expected decimal digits"),
    )
  }
  let mut number = 0
  let mut i = 0
  while i < value.length() {
    let digit = value.code_unit_at(i).to_int() - 48
    if digit < 0 || digit > 9 {
      return Err(
        codec_error(InvalidBodyLength, offset + i, "expected decimal digits"),
      )
    }
    if number > 2_000_000 {
      return Err(
        codec_error(
          FramingLimit,
          offset + i,
          "decimal field exceeds safe limit",
        ),
      )
    }
    number = number * 10 + digit
    i += 1
  }
  Ok(number)
}

///|
fn parse_three_digits(value : String, offset : Int) -> Result[Int, CodecError] {
  if value.length() != 3 {
    return Err(
      codec_error(InvalidChecksum, offset, "CheckSum must contain three digits"),
    )
  }
  let mut result = 0
  let mut i = 0
  while i < 3 {
    let digit = value.code_unit_at(i).to_int() - 48
    if digit < 0 || digit > 9 {
      return Err(
        codec_error(
          InvalidChecksum,
          offset + i,
          "CheckSum must contain decimal digits",
        ),
      )
    }
    result = result * 10 + digit
    i += 1
  }
  Ok(result)
}

///|
fn contains_soh(value : String) -> Bool {
  let mut i = 0
  while i < value.length() {
    if value[i] == '\u{1}' {
      return true
    }
    i += 1
  }
  false
}

///|
fn contains_non_ascii(value : String) -> Bool {
  let mut i = 0
  while i < value.length() {
    if value.code_unit_at(i).to_int() > 127 {
      return true
    }
    i += 1
  }
  false
}
