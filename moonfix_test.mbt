///|
test "encode and parse preserve ordered fields" {
  let original = @moonfix.message("FIX.4.4", [
    { tag: 35, value: "D", },
    { tag: 49, value: "BUY-SIDE", },
    { tag: 56, value: "SELL-SIDE", },
    { tag: 34, value: "7", },
    { tag: 11, value: "client-42", },
    { tag: 55, value: "MOON", },
    { tag: 54, value: "1", },
    { tag: 38, value: "25", },
    { tag: 40, value: "2", },
  ])
  let wire = match @moonfix.encode_message(original) {
    Ok(value) => value
    Err(_) => fail("encoding a valid order should succeed")
  }
  let decoded = match @moonfix.parse_message(wire) {
    Ok(value) => value
    Err(error) => fail(error.detail)
  }
  assert_eq(decoded.begin_string, "FIX.4.4")
  assert_eq(decoded.fields.length(), original.fields.length())
  assert_eq(decoded.fields[0].tag, 35)
  assert_eq(decoded.fields[1].tag, 49)
  assert_eq(decoded.fields[4].value, "client-42")
  match @moonfix.encode_message(decoded) {
    Ok(encoded) => assert_eq(encoded, wire)
    Err(error) => fail(error.detail)
  }
}

///|
test "checksum corruption is rejected" {
  let wire = match
    @moonfix.encode_message(
      @moonfix.message("FIX.4.4", [{ tag: 35, value: "0", }]),
    ) {
    Ok(value) => value
    Err(_) => fail("valid message should encode")
  }
  let changed = wire[0:wire.length() - 2].to_owned() + "0\u{1}"
  match @moonfix.parse_message(changed) {
    Ok(_) => fail("corrupt checksum must be rejected")
    Err(error) => assert_true(error.kind is @moonfix.ChecksumMismatch)
  }
}

///|
test "body length corruption is rejected" {
  let altered = "8=FIX.4.4\u{1}9=99\u{1}35=0\u{1}10=000\u{1}"
  match @moonfix.parse_message(altered) {
    Ok(_) => fail("incorrect BodyLength must be rejected")
    Err(error) => assert_true(error.kind is @moonfix.BodyLengthMismatch)
  }
}

///|
test "reserved framing tags cannot be encoded as body fields" {
  match
    @moonfix.encode_message(
      @moonfix.message("FIX.4.4", [{ tag: 10, value: "000", }]),
    ) {
    Ok(_) => fail("CheckSum is generated by the codec")
    Err(error) => assert_true(error.kind is @moonfix.ReservedTag)
  }
}

///|
test "non-ascii field values are rejected" {
  match
    @moonfix.encode_message(
      @moonfix.message("FIX.4.4", [{ tag: 58, value: "价格", }]),
    ) {
    Ok(_) => fail("wire is restricted to ASCII")
    Err(error) => assert_true(error.kind is @moonfix.InvalidField)
  }
}
